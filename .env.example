# ---- Banco (Postgres 17 compartilhado na VPS) -------------------------
# Mesmo servidor dos outros projetos; só muda o nome do banco (nodumpay).
# Use o mesmo host/usuário que os outros projetos já usam no DATABASE_URL.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST_DO_POSTGRES:5432/nodumpay"

# ---- Mercado Pago -----------------------------------------------------
# Credenciais de PRODUÇÃO da aplicação (começa com APP_USR-).
MP_ACCESS_TOKEN=""
# "Assinatura secreta" mostrada em Webhooks da aplicação no painel do MP.
MP_WEBHOOK_SECRET=""

# ---- API ---------------------------------------------------------------
# Endereço público DESTA API (backend), em HTTPS, sem barra no final.
# O Mercado Pago manda os webhooks para <APP_URL>/api/webhooks/mercadopago.
APP_URL="https://api.pay.nodumsolucoes.com"
# Token que o painel (frontend na Vercel) usa para ler/alterar o hub.
# Mesmo valor no frontend. >= 32 caracteres: openssl rand -base64 48
ADMIN_API_TOKEN=""
# O próprio hub reenvia entregas pendentes a cada N segundos (0 desliga).
DELIVERY_RETRY_INTERVAL_SECONDS="60"
# Opcional: protege /api/cron/deliveries para um agendador externo (Bearer).
CRON_SECRET=""

# Só para desenvolvimento local: aceita webhooks sem assinatura.
# ALLOW_UNSIGNED_WEBHOOKS="true"
